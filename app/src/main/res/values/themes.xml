<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TimerAlarm" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/red_soft</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">#D9D3CA</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.TimerAlarm.FullScreenAlarm" parent="Theme.TimerAlarm">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Gốc cho các style Mondiro.* (tên có dấu chấm cần style cha) -->
    <style name="Mondiro" />

    <!-- Nút phụ: nền kem, viền nhạt, icon + chữ đậm -->
    <style name="Mondiro.Button.Secondary" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/soft</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">@color/ripple_red</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Nút chính đỏ -->
    <style name="Mondiro.Button.Primary" parent="Mondiro.Button.Secondary">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/red</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="rippleColor">#55FFFFFF</item>
    </style>

    <style name="Mondiro.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="Mondiro.CardTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Mondiro.CardSub">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Mondiro.Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textColor">#5D6068</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Mondiro.Badge">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>
</resources>
