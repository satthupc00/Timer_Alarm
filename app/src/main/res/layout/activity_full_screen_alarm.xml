<?xml version="1.0" encoding="utf-8"?>
<!-- Màn báo toàn màn hình (dùng chung cho Activity và overlay). Màu/icon/animation gắn trong AlarmScreenUi -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_breakfast">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp"
            android:clipChildren="false">

            <View
                android:id="@+id/pulse1"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_pulse_peach" />

            <View
                android:id="@+id/pulse2"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_pulse_peach" />

            <FrameLayout
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_core"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/ivAlarmIcon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cup"
                    app:tint="@color/peach_ink" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvAlarmClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="0.03"
            android:textColor="@color/text_primary"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/tvAlarmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/breakfast_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlarmSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            style="@style/Mondiro.Button.Primary"
            android:layout_width="320dp"
            android:layout_height="58dp"
            android:text="@string/btn_dismiss"
            android:textSize="17sp"
            app:cornerRadius="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/alarm_hint"
            android:textColor="@color/text_faint"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:padding="16dp"
        android:text="@string/watermark"
        android:textColor="@color/text_faint"
        android:textSize="11sp" />
</FrameLayout>
