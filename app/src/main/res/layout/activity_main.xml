<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watermark"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- Card 1: Breakfast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/breakfast_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBreakfast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/breakfast_desc"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnTestFullScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_test_fullscreen"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface"
                android:textColor="@color/accent"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Card 2: Data expiry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/data_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_desc"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvExpiryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_status_none"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnRescan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_rescan"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface"
                android:textColor="@color/accent"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
